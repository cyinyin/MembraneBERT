  {
    "tokens": [
      "Referring",
      "to",
      "ZIF-62/CA",
      "composite",
      "membrane",
      "loaded",
      "with",
      "2",
      "wt%",
      "of",
      "ZIF-62",
      "demonstrated",
      "the",
      "CO2",
      "and",
      "CH4",
      "permeability",
      "of",
      "25.7",
      "Barrer",
      "and",
      "1.7",
      "Barrer",
      ",",
      "respectively",
      "which",
      "were",
      "62.6%",
      "and",
      "30.7%",
      "higher",
      "compared",
      "to",
      "the",
      "pristine",
      "membrane,",
      "respectively.",
      "Meanwhile,",
      "CO2/CH4",
      "ideal",
      "selectivity",
      "of",
      "composite",
      "membrane",
      "was",
      "increased",
      "from",
      "12.",
      "to",
      "15.",
      "as",
      "shown",
      "in",
      "4",
      "wt%",
      "of",
      "ZIF-62",
      "into",
      "CA",
      "matrix",
      "enhanced",
      "the",
      "CO2",
      "permeability",
      "and",
      "CO2/CH4",
      "ideal",
      "selectivity",
      "from",
      "25.",
      "to",
      "40",
      ".",
      "Barrer",
      "and",
      "15.1",
      "–",
      "19.2",
      "respectively.",
      "CO2",
      "permeability",
      "and",
      "CO2/CH4",
      "ideal",
      "selectivity",
      "of",
      "54.3",
      "Barrer",
      "and",
      "23.6",
      "were",
      "obtained",
      "over",
      "the",
      "ZIF-[6]-CA",
      "composite",
      "membrane",
      ",",
      "respectively.",
      "Meanwhile,",
      "integration",
      "of",
      "8",
      "wt%",
      "of",
      "ZIF-62",
      "particles",
      "into",
      "CA",
      "demonstrated",
      "the",
      "highest",
      "CO2",
      "permeability",
      "and",
      "CO2/CH4",
      "ideal",
      "selectivity",
      "of",
      "84.8",
      "Barrer",
      "and",
      "35.3",
      "respectively,",
      "which",
      "were",
      "436.7%",
      "and",
      "189.3%",
      "higher",
      "compared",
      "to",
      "the",
      "pristine",
      "membrane,",
      "respectively.",
      "The",
      "highest",
      "CO2",
      "permeability",
      "and",
      "CO2/CH4",
      "ideal",
      "selectivity",
      "of",
      "this",
      "mem­",
      "brane",
      "have",
      "also",
      "been",
      "supported",
      "by",
      "the",
      "highest",
      "FFV",
      "values",
      "shown",
      "in",
      "However,",
      "further",
      "increment",
      "of",
      "ZIF-62",
      "loading",
      "from",
      "8",
      "to",
      "10",
      "wt%",
      "into",
      "polymer",
      "matrix",
      "resulted",
      "in",
      "dramatic",
      "drop",
      "of",
      "CO2",
      "permeability",
      "and",
      "CO2/",
      "CH4",
      "ideal",
      "selectivity",
      "from",
      "84.",
      "to",
      "55.",
      "Barrer",
      "and",
      "35.3–26.2,",
      "respec­",
      "tively.",
      "Similarly,",
      "composite",
      "membrane",
      "loaded",
      "with",
      "12",
      "wt%",
      "of",
      "ZIF-62",
      "glass",
      "also",
      "showed",
      "the",
      "lower",
      "value",
      "of",
      "CO2",
      "permeability",
      "and",
      "CO2/CH4",
      "ideal",
      "selectivity",
      "compared",
      "to",
      "the",
      "composite",
      "membrane",
      "loaded",
      "with",
      "8",
      "wt",
      "%",
      "of",
      "ZIF-62",
      "glass",
      "particles.",
      "This",
      "decreasing",
      "trend",
      "could",
      "be",
      "attributed",
      "to",
      "the",
      "access",
      "loading",
      "of",
      "ZIF-62",
      "glass",
      "which",
      "could",
      "lead",
      "to",
      "cluster",
      "formation",
      "due",
      "to",
      "Van",
      "der",
      "Waals",
      "forces",
      "between",
      "the",
      "ZIF-62",
      "itself",
      "and",
      "thus,",
      "nonselective",
      "voids",
      "were",
      "produced",
      "in",
      "the",
      "composite",
      "membranes",
      "(Tessema,",
      "2017).",
      "In",
      "addition,",
      "pore",
      "blockage",
      "of",
      "ZIF-62",
      "glass",
      "particles",
      "due",
      "to",
      "the",
      "penetration",
      "of",
      "polymer",
      "could",
      "drop",
      "the",
      "CO2",
      "transport",
      "through",
      "the",
      "com­",
      "posite",
      "membranes",
      "(Lin,",
      "2020).",
      "These",
      "results",
      "are",
      "agreed",
      "with",
      "the",
      "SEM",
      "morphology",
      "of",
      "composite",
      "membranes",
      "where",
      "agglomeration",
      "of",
      "ZIF-62",
      "particles",
      "at",
      "loading",
      "of",
      "10",
      "wt%",
      "and",
      "12",
      "wt%",
      "in",
      "CA",
      "phase",
      "has",
      "been",
      "observed."
