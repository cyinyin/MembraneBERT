  {
    "tokens": [
      "Since",
      "composite",
      "membrane",
      "loaded",
      "with",
      "8",
      "wt%",
      "of",
      "ZIF-62",
      "particles",
      "(ZIF-[8]-CA)",
      "demonstrated",
      "efficient",
      "single",
      "gas",
      "performance,",
      "thus,",
      "it",
      "was",
      "further",
      "analyzed",
      "for",
      "CO2/CH4",
      "mixed",
      "gas",
      "separation.",
      "The",
      "ZIF-[8]-CA",
      "composite",
      "membrane",
      "demonstrated",
      "the",
      "CO2",
      "permeability",
      "and",
      "CO2/CH4",
      "separation",
      "factor",
      "of",
      "45.3",
      "Barrer",
      "and",
      "18.1",
      "during",
      "the",
      "mixed",
      "gas",
      "separation",
      "which",
      "were",
      "46.8%",
      "and",
      "48.7%",
      "lower",
      "compared",
      "to",
      "single",
      "gas",
      "CO2",
      "permeability",
      "and",
      "CO2/CH4",
      "ideal",
      "selectivity",
      "of",
      "84.",
      "Barrer",
      "and",
      "35.3,",
      "respectively.",
      "The",
      "lower",
      "performance",
      "of",
      "membrane",
      "was",
      "expected",
      "for",
      "mixed",
      "gas",
      "separation",
      "because",
      "of",
      "gas",
      "transport",
      "competition",
      "between",
      "CO2",
      "and",
      "CH4",
      "(Velioglu",
      "et",
      "al.,",
      "2012).",
      "In",
      "addition,",
      "dipole-dipole",
      "interaction",
      "and",
      "polarizability",
      "may",
      "also",
      "provide",
      "the",
      "extra",
      "resistance",
      "to",
      "reduce",
      "the",
      "CO2",
      "facilitated",
      "transport",
      "through",
      "the",
      "composite",
      "membrane",
      "(Velioglu",
      "et",
      "al.,",
      "2012)."
