  {
    "tokens": [
      "widely",
      "investigated",
      "and",
      "applied",
      "in",
      "CO2",
      "capture",
      "and",
      "separation",
      "processes",
      "The",
      "separation",
      "performance",
      "of",
      "a",
      "membrane",
      "is",
      "enhanced",
      "by",
      "the",
      "integration",
      "of",
      "functional",
      "fillers",
      ".",
      "However",
      ",",
      "the",
      "separation",
      "performance",
      "of",
      "MMMs",
      "must",
      "be",
      "further",
      "improved",
      "when",
      "undesirable",
      "channels",
      "are",
      "created",
      "by",
      "the",
      "agglomeration",
      "and",
      "non-uniform",
      "distribution",
      "of",
      "high-loading",
      "-",
      "weight",
      "inorganic",
      "particles",
      ".",
      "Abolfaz",
      "et",
      "al",
      ".",
      "modified",
      "ZIF-8",
      "with",
      "ethylenediamine",
      "amine",
      "(",
      "EDD-ZIF-8",
      ")",
      "to",
      "improve",
      "compatibility",
      "with",
      "a",
      "Pebax",
      "matrix",
      ".",
      "The",
      "glass",
      "transition",
      "temperature",
      "(",
      "Tg",
      ")",
      "of",
      "the",
      "resulting",
      "MMMs",
      "increased",
      "from",
      "−",
      "55",
      "◦",
      "C",
      "for",
      "the",
      "initial",
      "ZIF-8",
      "to",
      "−",
      "44.3",
      "◦",
      "C",
      "when",
      "the",
      "loading",
      "weight",
      "of",
      "EDD-ZIF-8",
      "was",
      "30",
      "wt%",
      ".",
      "The",
      "increase",
      "in",
      "Tg",
      "was",
      "ascribed",
      "to",
      "the",
      "rigidification",
      "of",
      "the",
      "polymer",
      "chain",
      "due",
      "to",
      "improved",
      "interactions",
      "with",
      "EDD-ZIF-8",
      ".",
      "Furthermore",
      ",",
      "the",
      "CO2",
      "permeability",
      "of",
      "the",
      "MMMs",
      "increased",
      "from",
      "100",
      "to",
      "130",
      "Barrer",
      "when",
      "the",
      "EDD-ZIF-8",
      "loading",
      "weight",
      "increased",
      "from",
      "0",
      "to",
      "30",
      "wt%",
      ",",
      "and",
      "a",
      "CO2/CH4",
      "selectivity",
      "of",
      "14.25",
      "was",
      "maintained",
      ".",
      "Ding",
      "et",
      "al",
      ".",
      "prepared",
      "MMMs",
      "with",
      "amino-modified",
      "ZIF-8",
      "(",
      "aminobenzimidazole",
      ",",
      "NH2-ZIF-8",
      ")",
      "to",
      "improve",
      "compatibility",
      "with",
      "a",
      "Pebax",
      "polymer",
      "matrix",
      ".",
      "Following",
      "modification",
      ",",
      "the",
      "morphology",
      "of",
      "NH2-ZIF-8",
      "transformed",
      "from",
      "rhombic",
      "dodecahedral",
      "to",
      "tetrahedral",
      ",",
      "and",
      "the",
      "particle",
      "size",
      "increased",
      ".",
      "An",
      "optimum",
      "CO2/N2",
      "selectivity",
      "of",
      "62.5",
      "was",
      "achieved",
      "with",
      "NH2-ZIF-8",
      "loading",
      "of",
      "6",
      "wt%",
      ".",
      "When",
      "the",
      "loading",
      "weight",
      "of",
      "NH2-ZIF-8",
      "increased",
      "to",
      "12",
      "wt%",
      ",",
      "the",
      "CO2/N2",
      "selectivity",
      "decreased",
      ".",
      "Both",
      "the",
      "diffusion",
      "and",
      "solubility",
      "selectivities",
      "of",
      "MMMs",
      "decreased",
      "when",
      "the",
      "loading",
      "weight",
      "of",
      "NH2-ZIF-8",
      "exceeded",
      "6",
      "wt%",
      ".",
      "This",
      "may",
      "be",
      "due",
      "to",
      "the",
      "formation",
      "of",
      "defects",
      "caused",
      "by",
      "large",
      "NH2-ZIF-8",
      "particles",
      "."
