      "3",
      "Steam-assisted",
      "crystallization",
      "The",
      "steam-assisted",
      "conversion",
      "(",
      "SAC",
      ")",
      "method",
      "is",
      "one",
      "of",
      "the",
      "seeding",
      "methods",
      "that",
      "can",
      "be",
      "used",
      "to",
      "produce",
      "SAPO-34",
      "membranes",
      "with",
      "high",
      "reproducibility",
      ".",
      "SAC",
      "combines",
      "the",
      "deposition",
      "of",
      "the",
      "seed-containing",
      "paste",
      "on",
      "membrane",
      "support",
      "and",
      "the",
      "transformation",
      "of",
      "the",
      "paste",
      "into",
      "a",
      "compact",
      "layer",
      "of",
      "seed",
      ",",
      "assisted",
      "by",
      "steam",
      "(",
      "Zhou",
      "et",
      "al",
      ".",
      "2014",
      ")",
      ".",
      "Zhou",
      "et",
      "al",
      ".",
      "have",
      "demonstrated",
      "this",
      "method",
      "to",
      "synthesize",
      "a",
      "continuous",
      "and",
      "thin",
      "SAPO-34",
      "membrane",
      "with",
      "a",
      "4",
      "µm",
      "thickness",
      ".",
      "The",
      "membrane",
      "exhibits",
      "high",
      "selectivity",
      "for",
      "various",
      "gas",
      "mixtures",
      ",",
      "and",
      "the",
      "compact",
      "gel",
      "layer",
      "helps",
      "to",
      "prevent",
      "the",
      "penetration",
      "of",
      "small",
      "seeds",
      "into",
      "the",
      "support",
      "pores",
      ".",
      "Another",
      "steam-assisted",
      "crystallization",
      "was",
      "demon",
      "-",
      "strated",
      "by",
      "Li",
      "et",
      "al",
