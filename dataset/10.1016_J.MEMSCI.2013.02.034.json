      "emission",
      "and",
      "implement",
      "end-of-pipe",
      "storage",
      "and",
      "further",
      "CO2",
      "utilizations",
      ".",
      "Besides",
      "the",
      "well",
      "-",
      "established",
      "cryogenic",
      "and",
      "absorption",
      "processes",
      ",",
      "membrane",
      "technology",
      "has",
      "been",
      "suggested",
      "because",
      "of",
      "its",
      "advantages",
      "on",
      "energy",
      "saving",
      ",",
      "small",
      "foot",
      "print",
      ",",
      "easy",
      "scale-up",
      "and",
      "ambient",
      "operation",
      ".",
      "Membrane",
      "technology",
      "is",
      "a",
      "proven",
      "technology",
      "for",
      "natural",
      "gas",
      "sweetening",
      ".",
