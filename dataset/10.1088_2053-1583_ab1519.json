      "was",
      "formed",
      "on",
      "the",
      "functionalized",
      "support",
      "with",
      "the",
      "aid",
      "of",
      "4",
      ",",
      "4",
      "’",
      "–",
      "biphenyldicarboxaldehyde",
      "(",
      "BPDA",
      ")",
      "and",
      "tetra",
      "-",
      "(",
      "4",
      "-",
      "anilyl",
      ")",
      "methane",
      "(",
      "TAM",
      ")",
      ".",
      "The",
      "membrane",
      "showed",
      "relatively",
      "good",
      "performance",
      "for",
      "H2",
      "separation",
      ".",
      "Li",
      "et",
      "al",
      ".",
      "assembled",
      "COF-1",
      "nanosheets",
      "on",
      "the",
      "α-Al2O3",
      "support",
      "via",
      "vacuum",
      "filtration",
      "technique",
      ".",
      "A",
      "SiO2-ZrO2",
      "intermediate",
      "layer",
      "was",
      "deposited",
      "on",
      "the",
      "ceramic",
      "support",
      "to",
      "provide",
      "a",
      "smooth",
      "surface",
      "for",
      "coating",
      "of",
      "the",
      "selective",
      "layer",
      ".",
      "Subsequently",
      ",",
      "a",
      "suspension",
      "of",
      "COF-1",
      "nanosheets",
      "in",
      "dichloromethane",
      "was",
      "deposited",
      "on",
      "the",
      "modified",
      "support",
      "via",
      "drop",
      "-",
      "coating",
      "method",
      "followed",
      "by",
      "drying",
      "at",
      "room",
      "temperature",
      "(",
      "Fig",
      ".",
      "14a",
      ")",
      ".",
      "In",
      "order",
      "to",
      "make",
      "a",
      "uniform",
      ",",
      "defect-free",
      "selective",
      "layer",
      "with",
      "desired",
      "thickness",
      ",",
      "the",
      "coating-drying",
      "cycle",
      "was",
      "repeated",
      "several",
      "times",
      ".",
      "The",
      "COF-1",
      "composite",
      "membrane",
      "showed",
      "exceptional",
      "H2",
      "permeance",
      "of",
      "5000",
      "GPU",
      "at",
      "room",
      "temperature",
      ",",
      "significantly",
      "higher",
      "than",
      "those",
      "reported",
      "for",
      "GO",
      "and",
      "MOF",
      "membranes",
      "(",
      "Fig",
      ".",
      "14b",
      ")",
      ",",
      "along",
      "with",
      "good",
      "stability",
      "at",
      "elevated",
      "temperature",
      "(",
      "350",
      "℃",
      ")",
      ".",
      "However",
      ",",
      "selectivity",
      "of",
      "membrane",
      "still",
      "is",
      "lower",
      "than",
      "values",
      "reported",
      "for",
      "other",
      "2D-mateial",
      "based",
      "membranes",
      "most",
      "likely",
      "due",
      "to",
      "the",
      "large",
      "size",
      "of",
      "pores",
      ".",
      "Fan",
      "et",
      "al",
      ".",
      "fabricated",
      "a",
      "COF-COF",
      "bilayer",
      "composite",
      "membrane",
      "on",
      "a",
      "porous",
      "support",
      "via",
      "solvothermal",
      "temperature-swing",
      "method",
      ".",
      "The",
      "first",
      "and",
      "second",
      "layers",
      "were",
      "imine-linked",
      "COF-LZU1",
      "(",
      "aperture",
      "size",
      "about",
      "1.8",
      "nm",
      ")",
      "and",
      "azine-linked",
      "ACOF-1",
      "(",
      "aperture",
      "size",
      "about",
      "0.94",
      "nm",
      ")",
      ",",
      "respectively",
      ".",
      "The",
      "COF-LZU1-ACOF-1",
      "membrane",
      "presented",
      "H2",
      "permeance",
      "of",
      "750",
      "GPU",
      "and",
      "H2/CO2",
      "selectivity",
      "of",
      "25",
      ",",
      "at",
      "room",
      "temperature",
      "and",
      "1",
      "bar",
      ".",
      "Furthermore",
      ",",
      "H2",
      "permeance",
      "of",
      "membrane",
      "enhanced",
      "from",
      "750",
      "GPU",
      "to",
      "1550",
      "GPU",
      "upon",
      "increasing",
      "the",
      "temperature",
      "from",
      "25",
      "to",
      "120",
      "℃",
      "."
