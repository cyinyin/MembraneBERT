      "among",
      "PIM-1",
      "membranes",
      "fabricated",
      "at",
      "different",
      "locations",
      "is",
      "a",
      "well-known",
      "fact",
      ",",
      "being",
      "affected",
      "by",
      "the",
      "molecular",
      "weight",
      "of",
      "the",
      "polymer",
      ",",
      "membrane",
