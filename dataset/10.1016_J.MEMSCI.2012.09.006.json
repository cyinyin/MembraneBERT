      "The",
      "required",
      "quantity",
      "of",
      "nano-particles",
      "is",
      "much",
      "smaller",
      "for",
      "composite",
      "membrane",
      "fabrication",
      ",",
      "because",
      "they",
      "are",
      "only",
      "located",
      "in",
      "the",
      "selective",
      "skin",
      "and",
      "not",
      "in",
      "the",
      "porous",
      "sub-structure",
      ".",
      "5",
      ".",
      "Conclusions",
      "In",
      "summary",
      ",",
      "very",
      "thin",
      "layers",
      "of",
      "Pebaxs1657",
      "blended",
      "with",
      "ZIF-7",
      "have",
