  {
    "tokens": [
      "This",
      "makes",
      "the",
      "composite",
      "mixed",
      "matrix",
      "membranes",
      "very",
      "attractive",
      "for",
      "applications",
      "like",
      "natural",
      "gas",
      "sweetening",
      "or",
      "biogas",
      "puriﬁcation",
      ".",
      "The",
      "asymmetric",
      "membranes",
      "achieve",
      "a",
      "CO2",
      "permeance",
      "around",
      "100",
      "GPU",
      "and",
      "selectivity",
      "around",
      "15",
      "for",
      "CO2/CH4",
      ",",
      "whereas",
      "PZ-2",
      "in",
      "this",
      "study",
      "exhibits",
      "a",
      "permeance",
      "of",
      "CO2",
