      "Not",
      "only",
      "is",
      "the",
      "performance",
      "of",
      "the",
      "composite",
      "membrane",
      "higher",
      "than",
      "the",
      "asymmetric",
      "membrane",
      ",",
      "but",
      "also",
      "their",
      "facile",
      "preparation",
      "process",
      "makes",
      "them",
      "much",
      "more",
      "suitable",
      "for",
      "industrial",
      "membrane",
      "fabrication",
      ".",
      "It",
      "is",
      "more",
      "difﬁcult",
      "to",
      "prepare",
      "asymmetric",
      "mixed",
      "matrix",
      "membranes",
      "for",
      "the",
      "following",
      "reasons",
      ":",
      "the",
      "polymer",
      "materials",
      "that",
      "can",
      "be",
      "processed",
      "into",
      "asymmetric",
      "membrane",
      "is",
      "quite",
      "limited",
      ".",
      "The",
      "inorganic",
      "ﬁller",
      "can",
      "easily",
      "induce",
      "defects",
      "when",
      "the",
      "selective",
      "skin",
      "layer",
      "is",
      "formed",
