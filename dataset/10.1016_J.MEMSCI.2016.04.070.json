  {
    "tokens": [
      "We",
      "then",
      "investigated",
      "the",
      "relations",
      "between",
      "selectivities",
      "and",
      "pore",
      "sizes",
      "of",
      "MOFs",
      ".",
      "Fig",
      ".",
      "2",
      "(",
      "a",
      ")",
      "represents",
      "adsorption",
      "selectivity",
      "as",
      "a",
      "function",
      "of",
      "LPD",
      "of",
      "materials",
      ".",
      "MOFs",
      "with",
      "LPDs",
      "less",
      "than",
      "5",
      "Å",
      "gen",
      "-",
      "erally",
      "exhibit",
      "higher",
      "adsorption",
      "selectivity",
      "than",
      "MOFs",
      "with",
      "larger",
      "LPDs",
      ".",
      "For",
      "example",
      ",",
      "IPIDAN",
      "has",
      "the",
      "smallest",
      "LPD",
      "(",
      "2.99",
      "/",
      "5.09",
      "Å",
      ")",
      "among",
      "172",
      "MOFs",
      "considered",
      "in",
      "this",
      "work",
      "and",
      "its",
      "adsorption",
      "se",
      "-",
      "lectivity",
      "is",
      "the",
      "highest",
      ".",
      "Similarly",
      ",",
      "PAVLUU",
      "and",
      "SUGWEX03",
      "have",
      "narrow",
      "LPDs",
      ",",
      "4.09",
      "Å",
      "and",
      "3.81",
      "Å",
      ",",
      "respectively",
      "and",
      "they",
      "exhibit",
      "high",
      "adsorption",
      "selectivities",
      "(",
      "160",
      "and",
      "127",
      ",",
      "respectively",
      ")",
      "for",
      "CH4/H2",
      "separation",
      ".",
      "This",
      "is",
      "expected",
      "because",
      "larger",
      "CH4",
      "molecules",
      "can",
      "strongly",
      "conﬁne",
      "in",
      "small",
      "cavities",
      "of",
      "the",
      "MOFs",
      "leading",
      "to",
      "high",
      "adsorption",
      "selectivity",
      "for",
      "CH4",
      ".",
      "MOFs",
      "that",
      "have",
      "larger",
      "LPDs",
      "(",
      "410",
      "Å",
      ")",
      "generally",
      "have",
      "lower",
      "adsorption",
      "selectivities",
      ",",
      "around",
      "11",
      ",",
      "since",
      "both",
      "large",
      "CH4",
      "and",
      "small",
      "H2",
      "molecules",
      "of",
      "the",
      "mixture",
      "are",
      "able",
      "to",
      "enter",
      "into",
      "the",
      "pores",
      ".",
      "There",
      "is",
      "not",
      "a",
      "direct",
      "correlation",
      "be",
      "-",
      "tween",
      "diffusion",
      "selectivity",
      "and",
      "the",
      "LPDs",
      "of",
      "MOFs",
      "as",
      "shown",
      "in",
      "Fig",
      ".",
      "2",
      "(",
      "b",
      ")",
      ".",
      "One",
      "obvious",
      "result",
      "from",
      "this",
      "ﬁgure",
      "is",
      "that",
      "regardless",
      "of",
      "the",
      "pore",
      "size",
      ",",
      "H2",
      "diffuses",
      "faster",
      "than",
      "CH4",
      "in",
      "all",
      "MOFs",
      "and",
      "diffusion",
      "selectivity",
      "for",
      "CH4",
      "becomes",
      "less",
      "than",
      "1",
      ".",
      "The",
      "diffusion",
      "selectivity",
      "of",
      "MOFs",
      "having",
      "LPDs",
      "less",
      "than",
      "4",
      "Å",
      "is",
      "generally",
      "very",
      "low",
      ",",
      "o0",
      ".",
      "08",
      ",",
      "be",
      "-",
      "cause",
      "small",
      "H2",
      "molecules",
      "(",
      "2.96",
      "Å",
      ")",
      "can",
      "pass",
      "through",
      "the",
      "narrow",
      "pores",
      "whereas",
      "larger",
      "CH4",
      "molecules",
      "(",
      "3.73",
      "Å",
      ")",
      "cannot",
      ".",
      "For",
      "example",
      ",",
      "YOZBIZ01",
      "has",
      "large",
      "cages",
      "(",
      "8.03",
      "Å",
      ")",
      "connected",
      "by",
      "narrow",
      "windows",
      "(",
      "3.62",
      "Å",
      ")",
      ".",
      "The",
      "diffusion",
      "of",
      "CH4",
      "(",
      "1",
      "×",
      ".",
      "6",
      "×",
      "10",
      "^",
      "6",
      "cm2/s",
      ")",
      "is",
      "almost",
      "two",
      "orders",
      "of",
      "magnitude",
      "slower",
      "than",
      "H2",
      "(",
      "1",
      "×",
      ".",
      "4",
      "×",
      "10",
      "^",
      "4",
      "cm2/s",
      ")",
      "in",
      "this",
      "MOF",
      ".",
      "As",
      "a",
      "result",
      ",",
      "YOZBIZ01",
      "exhibits",
      "very",
      "low",
      "diffusion",
      "selectivity",
      "(",
      "0.01",
      ")",
      "for",
      "CH4",
      ".",
      "Overall",
      ",",
      "these",
      "results",
      "suggest",
      "that",
      "narrow-pored",
      "MOFs",
      "generally",
      "exhibit",
      "high",
      "adsorption",
      "selectivity",
      "but",
      "low",
      "diffu",
      "-",
      "sion",
      "selectivity",
      "for",
      "CH4",
      "."
