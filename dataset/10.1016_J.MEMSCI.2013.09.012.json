  {
    "tokens": [
      "The",
      "temperature",
      "dependencies",
      "of",
      "permeability",
      ",",
      "diffusivity",
      ",",
      "solubility",
      ",",
      "activation",
      "energies",
      ",",
      "and",
      "the",
      "heats",
      "of",
      "sorption",
      "for",
      "propylene",
      "and",
      "propane",
      "were",
      "analyzed",
      "for",
      "the",
      "ZIF-8",
      "layer",
      "in",
      "the",
      "membrane",
      "prepared",
      "using",
      "a",
      "reaction",
      "time",
      "of",
      "72",
      "h",
      "(",
      "2c",
      ")",
      ".",
      "The",
      "permeability",
      "of",
      "propylene",
      "and",
      "propane",
      "for",
      "the",
      "ZIF-8",
      "layer",
      "prepared",
      "within",
      "the",
      "substrate",
      "was",
      "determined",
      "by",
      "considering",
      "the",
      "effect",
      "of",
      "the",
      "substrate",
      "porosity",
      ".",
      "In",
      "this",
      "study",
      ",",
      "we",
      "successfully",
      "determined",
      "separately",
      "the",
      "diffusivity",
      "values",
      "for",
      "propylene",
      "and",
      "propane",
      "from",
      "the",
      "permeation",
      "measurements",
      "at",
      "25",
      "℃",
      ",",
      "which",
      "were",
      "3.1×10-11",
      "and",
      "1.3×10-12",
      "m2",
      "s-1",
      ",",
      "respectively",
      ".",
      "Zhang",
      "et",
      "al",
      ".",
      "have",
      "previously",
      "studied",
      "the",
      "diffusivity",
      "of",
      "propylene",
      "and",
      "propane",
      "in",
      "ZIF-8",
      "crystals",
      "using",
      "kinetic",
      "uptake",
      "curves",
      "of",
      "propylene",
      "and",
      "propane",
      "of",
      "2.9×10-12",
      "and",
      "2.0×10-14",
      "m2",
      "·",
      "s-1",
      ",",
      "respectively",
      ".",
      "The",
      "diffusion",
      "separation",
      "factor",
      "for",
      "propylene/propane",
      "reported",
      "by",
      "Zhang",
      "et",
      "al",
      ".",
      "is",
      "more",
      "than",
      "two",
      "orders",
      "of",
      "magnitude",
      ".",
      "In",
      "this",
      "study",
      ",",
      "the",
      "diffusion",
      "separation",
      "factor",
      "for",
      "propylene/propane",
      "in",
      "the",
      "ZIF-8",
      "layer",
      "was",
      "found",
      "to",
      "be",
      "approximately",
      "23",
      ";",
      "whereas",
      ",",
      "that",
      "reported",
      "by",
      "Zhang",
      "et",
      "al",
      ".",
      "corresponded",
      "to",
      "the",
      "maximum",
      "diffusion",
      "separation",
      "factor",
      "for",
      "propylene",
      "and",
      "propane",
      "in",
      "the",
      "ideal",
      "ZIF-8",
      "layer",
      "without",
      "any",
      "defects",
      ".",
      "These",
      "differences",
      "may",
      "derive",
      "from",
      "the",
      "non-uniformity",
      "of",
      "the",
      "ZIF-8",
      "layer",
      ",",
      "as",
      "well",
      "as",
      "from",
      "the",
      "remaining",
      "small",
      "defects",
      "and",
      "cavities",
      "in",
      "the",
      "ZIF-8",
      "layer",
      "prepared",
      "in",
      "this",
      "study",
      ".",
      "This",
      "implies",
      "that",
      "improvements",
      "in",
      "the",
      "propylene/propane",
