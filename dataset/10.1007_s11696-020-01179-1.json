  {
    "tokens": [
      "For",
      "the",
      "industrialization",
      "and",
      "commercialization",
      "of",
      "membrane,",
      "one",
      "component",
      "from",
      "a",
      "mixture",
      "of",
      "gas",
      "permeates",
      "significantly",
      "as",
      "compared",
      "to",
      "other.",
      "Hence,",
      "high",
      "permeability",
      "and",
      "selectivity",
      "were",
      "the",
      "most",
      "vital",
      "factors",
      "for",
      "the",
      "selection",
      "of",
      "particular",
      "membrane",
      "for",
      "commercialization.",
      "The",
      "results",
      "obtained",
      "from",
      "PU/γ-CD-MOF",
      "MMM",
      "were",
      "compared",
      "with",
      "Robeson’s",
      "line",
      "for",
      "­",
      "CO2/CH4",
      "separation.",
      "In",
      "addition,",
      "the",
      "incorporation",
      "of",
      "γ-CD-MOF",
      "as",
      "filler",
      "in",
      "polyurethane",
      "results",
      "in",
      "high",
      "results",
      "permeability",
      "and",
      "selectivity",
      "of",
      "­",
      "CO2",
      "specifically",
      "(Amedi",
      "and",
      "Aghajani",
      "2016;",
      "Ameri",
      "et",
      "al.",
      "2015;",
      "Robeson",
      "2008",
      "and",
      "Sadeghi",
      "et",
      "al.",
      "2011a,",
      "b,",
      "c).",
      "As",
      "in",
      "single",
      "gas",
      "testing,",
      "each",
      "PU/γ-CD-MOF",
      "membrane",
      "sample",
      "was",
      "tested",
      "at",
      "pressure",
      "1-5",
      "bar",
      "for",
      "both",
      "­",
      "ity",
      "and",
      "selectivity",
      "results",
      "were",
      "recorded.",
      "With",
      "the",
      "increase",
      "in",
      "pressure",
      "and",
      "filler",
      "weight",
      "percentage,",
      "drop",
      "in",
      "permeability",
      "was",
      "observed",
      "for",
      "both",
      "gases.",
      "However,",
      "optimum",
      "­",
      "CO2/CH4",
      "selectivity",
      "was",
      "obtained",
      "at",
      "5",
      "bar",
      "pressure.",
      "Among",
      "all",
      "samples,",
      "optimum",
      "­",
      "CO2",
      "permeability",
      "and",
      "CO2/CH4",
      "were",
      "achieved",
      "at",
      "5",
      "bar",
      "in",
      "PU/γ-CD-MOF",
      "(0.2",
      "wt%",
      ")",
      "214",
      "barrer",
      "and",
      "28.57",
      "and",
      "PU/γ-CD-MOF",
      "(0.4",
      "wt%",
      ")",
      "186",
      "barrer",
      "and",
      "23.25.",
      "Mixed",
      "gas",
      "testing",
      "of",
      "pure",
      "PU",
      "and",
      "PU/γ‑CD‑MOF",
      "MMM",
      "For",
      "further",
      "analysis",
      "of",
      "the",
      "permeability",
      "and",
      "selectivity",
      "of",
      "PU/γ-CD-MOF",
      "MMM,",
      "mixed",
      "gas",
      "testing",
      "of",
      "­",
      "CO2/CH4",
      "was",
      "performed.",
      "The",
      "ratio",
      "involved",
      "of",
      "­",
      "CO2/CH4",
      "mixture",
      "of",
      "gases",
      "is",
      "50/50",
      "and",
      "introduced",
      "at",
      "similar",
      "condition",
      "to",
      "that",
      "of",
      "single",
      "gas",
      "testing",
      "at",
      "35",
      "°C",
      "and",
      "at",
      "5",
      "bar.",
      "The",
      "trend",
      "followed",
      "of",
      "permeability",
      "and",
      "selectivity",
      "against",
      "filler",
      "concentrations",
      "and",
      "pressure",
      "was",
      "similar",
      "to",
      "that",
      "of",
      "single",
      "gas",
      "testing.",
      "Relationship",
      "between",
      "permeability",
      "of",
      "­",
      "CH4",
      "with",
      "filler",
      "wt%",
      "represented",
      "by",
      "graph",
      "in",
      "CO2/CH4",
      "selectivity",
      "with",
      "pressure",
      "in",
      "permeability",
      "and",
      "selectivity",
      "observed",
      "in",
      "mixed",
      "gas",
      "testing",
      "when",
      "both",
      "gases",
      "strike",
      "simultaneously",
      "on",
      "membrane",
      "surface",
      "(Tables",
      "4,",
      "5)."
