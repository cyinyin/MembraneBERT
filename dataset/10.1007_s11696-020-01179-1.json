  {
    "tokens": [
      "Effect",
      "of",
      "filler",
      "concentration",
      "on",
      "­",
      "CO2",
      "and",
      "­",
      "CH4",
      "permeabil‑",
      "ity",
      "ing",
      "on",
      "the",
      "permeability",
      "of",
      "­",
      "CH4",
      "in",
      "pure",
      "PU",
      "and",
      "PU/γ-cd-mof",
      "in",
      "single",
      "gas",
      "testing",
      "also",
      "show",
      "the",
      "values",
      "of",
      "permeability",
      "obtained",
      "against",
      "filler",
      "weight",
      "percentage",
      "of",
      "­",
      "ples.",
      "Initially",
      "in",
      "pristine",
      "PU",
      "permeability",
      "of",
      "CO2",
      "and",
      "CH4",
      "at",
      "pressure",
      "5",
      "bar",
      "is",
      "112",
      "and",
      "5",
      "barrer",
      ",",
      "respectively,",
      "and",
      "CO2/CH4",
      "selectivity",
      "is",
      "of",
      "21",
      ".",
      "As",
      "shown",
      "in",
      "figures,",
      "permeability",
      "of",
      "both",
      "gases",
      "reduced",
      "with",
      "increasing",
      "the",
      "filler",
      "loading",
      "in",
      "PU.",
      "Incorporation",
      "of",
      "filler",
      "might",
      "have",
      "two",
      "possibilities,",
      "either",
      "it",
      "enhances",
      "the",
      "permeability",
      "by",
      "disturbing",
      "polymeric",
      "chain",
      "packing.",
      "As",
      "reported",
      "mostly",
      "in",
      "glassy",
      "polymers;",
      "addition",
      "of",
      "20",
      "vol%",
      "silica",
      "in",
      "polysulfone",
      "that",
      "result",
      "in",
      "increased",
      "permeability",
      "of",
      "both",
      "­",
      "Or",
      "filler",
      "creates",
      "hindrance",
      "in",
      "the",
      "permeation",
      "of",
      "gas",
      "molecules",
      "by",
      "increasing",
      "diffusion",
      "path",
      "length",
      "(Sadeghi",
      "et",
      "al.",
      "2009).",
      "In",
      "PU/γ-CD-MOF",
      "0.",
      "wt%",
      "optimum",
      "permeability",
      "obtained",
      "at",
      "pressure",
      "5",
      "bar",
      "214",
      "and",
      "7.",
      "barrer",
      "for",
      "­",
      "CO2",
      "and",
      "CH4.",
      "Gradual",
      "decrease",
      "in",
      "permeability",
      "of",
      "both",
      "carbon",
      "dioxide",
      "­",
      "(CO2)",
      "and",
      "methane",
      "­",
      "(CH4)",
      "is",
      "observed",
      "with",
      "increase",
      "in",
      "filler",
      "weight",
      "percentage",
      "in",
      "PU/γ-CD-MOF",
      "membrane",
      "samples",
      "from",
      "0.",
      "to",
      "1",
      "wt%",
      "at",
      "5",
      "bar",
      "pressure.",
      "Similar",
      "trend",
      "was",
      "observed",
      "with",
      "the",
      "incorporation",
      "of",
      "alumina",
      "nano-particles,",
      "zinc",
      "oxide",
      "nano-particle",
      "and",
      "silica",
      "nano-particle",
      "in",
      "polyurethane",
      "matrix",
      "(Ameri",
      "et",
      "al.",
      "2015;",
      "Hafeez",
      "et",
      "al.",
      "2015;",
      "Sadeghi",
      "et",
      "al.",
      "2011b;",
      "Soltani",
      "and",
      "Asghari",
      "2017a,",
      "b)."
