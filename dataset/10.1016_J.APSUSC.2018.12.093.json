  {
    "tokens": [
      "As",
      "revealed",
      "by",
      "PALS,",
      "the",
      "chemical",
      "incorporation",
      "of",
      "proper",
      "amount",
      "of",
      "OPS",
      "into",
      "PDMS",
      "membrane",
      "could",
      "enlarge",
      "the",
      "large",
      "and",
      "small",
      "free",
      "volume",
      "cavities",
      "of",
      "PDMS",
      "simultaneously.",
      "It",
      "could",
      "be",
      "concluded",
      "theoretically",
      "that",
      "OPS",
      "cages,",
      "PDMS’",
      "large",
      "free",
      "volume",
      "cavity",
      "(0.4094nm-0.4262nm),",
      "and",
      "small",
      "free",
      "volume",
      "cavity",
      "(0.3016nm-0.3511nm)",
      "could",
      "permit",
      "ethanol",
      "and",
      "water",
      "diffusion.",
      "The",
      "numerous",
      "hydrophobic",
      "POSS",
      "cages",
      "and",
      "enlarged",
      "PDMS’",
      "free",
      "volume",
      "would",
      "effectively",
      "improve",
      "the",
      "diffusion",
      "selectivity",
      "towards",
      "ethanol.",
      "Swelling",
      "and",
      "vapor",
      "adsorption",
      "measurements",
      "indicated",
      "that",
      "the",
      "chemical",
      "incorporation",
      "of",
      "moderate",
      "amount",
      "of",
      "OPS",
      "into",
      "PDMS",
      "not",
      "only",
      "improved",
      "ethanol",
      "vapor",
      "adsorption",
      "amount,",
      "but",
      "also",
      "depressed",
      "water",
      "adsorption",
      "amount",
      "in",
      "PDMS,",
      "which",
      "would",
      "obviously",
      "improve",
      "PDMS’",
      "sorption",
      "selectivity",
      "to",
      "ethanol.",
      "The",
      "macro-crosslinker",
      "OPS",
      "improved",
      "both",
      "thermal",
      "stability",
      "and",
      "tensile",
      "strength",
      "of",
      "PDMS",
      "membranes.",
      "(2)",
      "As",
      "applied",
      "to",
      "the",
      "bio-ethanol",
      "recovery",
      "from",
      "aqueous",
      "solutions,",
      "the",
      "prepared",
      "OPS/PDMS",
      "MMMs",
      "exhibited",
      "a",
      "simultaneous",
      "increase",
      "in",
      "permeation",
      "flux",
      "and",
      "separation",
      "factor,",
      "breaking",
      "the",
      "permeation",
      "flux-separation",
      "factor",
      "trade-off",
      "limitation.",
      "The",
      "PV",
      "performance",
      "enhancement",
      "was",
      "resulted",
      "from",
      "the",
      "improved",
      "sorption",
      "and",
      "diffusion",
      "selectivity",
      "towards",
      "ethanol",
      "by",
      "the",
      "chemical",
      "incorporation",
      "of",
      "OPS.",
      "As",
      "OPS",
      "loading",
      "was",
      "7.5wt%",
      ",",
      "the",
      "separation",
      "factor",
      "of",
      "OPS/PDMS",
      "MMMs",
      "reached",
      "the",
      "maximum",
      "value",
      "of",
      "16.4",
      "(109%",
      "higher",
      "than",
      "that",
      "of",
      "pure",
      "PDMS",
      "membrane),",
      "with",
      "permeation",
      "flux",
      "of",
      "253.1g/m2h",
      "(32%",
      "higher",
      "than",
      "that",
      "of",
      "pure",
      "PDMS",
      "membrane).",
      "(3)",
      "Both",
      "ethanol",
      "and",
      "water",
      "flux",
      "of",
      "OPS/PDMS",
      "MMMs",
      "increased",
      "with",
      "the",
      "augment",
      "of",
      "operation",
      "temperature,",
      "while",
      "the",
      "ethanol",
      "and",
      "water",
      "permeability",
      "followed",
      "the",
      "reversed",
      "order.",
      "This",
      "interesting",
      "phenomenon",
      "indicated",
      "that",
      "the",
      "increase",
      "of",
      "permeation",
      "flux",
      "was",
      "mainly",
      "ascribed",
      "to",
      "the",
      "remarkable",
      "increase",
      "in",
      "external",
      "driving",
      "force",
      "(saturated",
      "vapor",
      "pressure)",
      "rather",
      "than",
      "the",
      "variation",
      "of",
      "intrinsic",
      "membrane",
      "micro-structure.",
      "(4)",
      "As",
      "ethanol",
      "feed",
      "concentration",
      "increased,",
      "the",
      "total",
      "flux",
      "of",
      "OPS/PDMS",
      "hybrid",
      "membrane",
      "increased",
      "as",
      "well,",
      "while",
      "the",
      "separation",
      "factor",
      "and",
      "membrane",
      "selectivity",
      "followed",
      "the",
      "reversed",
      "order.",
      "The",
      "changes",
      "in",
      "driving",
      "force,",
      "swelling",
      "behavior",
      "of",
      "membranes",
      "and",
      "coupling",
      "effect",
      "of",
      "ethanol/water",
      "molecules",
      "with",
      "increasing",
      "ethanol",
      "concentration",
      "competed",
      "with",
      "each",
      "other.",
      "The",
      "driving",
      "force",
      "variation",
      "and",
      "enhanced",
      "coupling",
      "effect",
      "with",
      "increased",
      "ethanol",
      "feed",
      "concentration",
      "played",
      "a",
      "more",
      "important",
      "role",
      "in",
      "PV",
      "performance",
      "than",
      "that",
      "of",
      "intrinsic",
      "membrane",
      "structure,",
      "and",
      "finally",
      "resulted",
      "in",
      "the",
      "sharp",
      "decline",
      "of",
      "separation",
      "factor",
      "and",
      "slight",
      "decrease",
      "of",
      "membrane",
      "selectivity."
