  {
    "tokens": [
      "Fig.",
      "illustrated",
      "the",
      "permeability",
      "of",
      "MMMs",
      "with",
      "increasing",
      "ethanol",
      "feed",
      "concentration.",
      "By",
      "decoupling",
      "the",
      "driving",
      "forces,",
      "ethanol",
      "permeability",
      "decreased",
      "sharply,",
      "while",
      "water",
      "permeability",
      "decreased",
      "slightly",
      "with",
      "feed",
      "ethanol",
      "concentration",
      "and",
      "almost",
      "reached",
      "a",
      "plateau",
      "at",
      "ethanol",
      "concentration",
      "above",
      "10wt%.",
      "This",
      "indicated",
      "that",
      "the",
      "increase",
      "of",
      "ethanol",
      "flux",
      "was",
      "mainly",
      "attributed",
      "to",
      "the",
      "increased",
      "driving",
      "force",
      "rather",
      "than",
      "the",
      "intrinsic",
      "membrane",
      "properties.",
      "Moreover,",
      "the",
      "effect",
      "of",
      "membrane",
      "swelling",
      "and",
      "coupling",
      "effect",
      "of",
      "small",
      "molecules",
      "on",
      "water",
      "permeability",
      "almost",
      "counteracted",
      "with",
      "each",
      "other,",
      "which",
      "resulted",
      "in",
      "a",
      "basically",
      "unchanged",
      "water",
      "permeability.",
      "Fig.",
      "also",
      "showed",
      "that",
      "ethanol",
      "permeability",
      "was",
      "actually",
      "higher",
      "than",
      "water",
      "permeability",
      "over",
      "the",
      "whole",
      "ethanol",
      "feed",
      "concentration",
      "range",
      "studied",
      "in",
      "this",
      "work,",
      "indicating",
      "that",
      "the",
      "intrinsic",
      "property",
      "of",
      "the",
      "OPS/PDMS",
      "MMMs",
      "were",
      "ethanol",
      "perm-selective.",
      "As",
      "shown",
      "in",
      "sharply,",
      "and",
      "membrane",
      "selectivity",
      "decreased",
      "slightly",
      "with",
      "increasing",
      "ethanol",
      "concentration.",
      "This",
      "also",
      "suggested",
      "that",
      "the",
      "driving",
      "force",
      "variation",
      "with",
      "increased",
      "ethanol",
      "feed",
      "concentration",
      "played",
      "a",
      "more",
      "important",
      "role",
      "in",
      "PV",
      "performance",
      "than",
      "that",
      "of",
      "intrinsic",
      "membrane",
      "structure.",
      "The",
      "slight",
      "decrease",
      "of",
      "membrane",
      "selectivity",
      "was",
      "mainly",
      "ascribed",
      "to",
      "the",
      "membrane",
      "swelling",
      "and",
      "coupling",
      "effect",
      "of",
      "small",
      "molecules",
      "with",
      "the",
      "augment",
      "of",
      "ethanol",
      "concentration.",
      "3.",
      "Long-Term",
      "Operation",
      "Stability",
      "The",
      "effect",
      "of",
      "long",
      "time",
      "operation",
      "on",
      "PV",
      "performance",
      "of",
      "OPS/PDMS",
      "MMMs",
      "(OPS",
      "loading",
      "of",
      "7.5wt%,",
      "50℃)",
      "was",
      "shown",
      "in",
      "MMMs",
      "didn’t",
      "show",
      "significant",
      "fluctuations.",
      "It",
      "indicated",
      "that",
      "the",
      "PV",
      "performance",
      "of",
      "the",
      "OPS/PDMS",
      "MMMs",
      "cured",
      "by",
      "OPS",
      "was",
      "stable",
      "during",
      "the",
      "two",
      "days",
      "operation",
      "time.",
      "3.",
      "Comparison",
      "of",
      "PV",
      "Performances",
      "of",
      "PDMS-Based",
      "MMMs",
      "membranes",
      "for",
      "ethanol",
      "recovery.",
      "It",
      "can",
      "be",
      "seen",
      "that",
      "the",
      "separation",
      "factor",
      "of",
      "pristine",
      "PDMS",
      "composite",
      "membranes",
      "reported",
      "in",
      "literature",
      "ranged",
      "between",
      "5.",
      "and",
      "10.8,",
      "and",
      "the",
      "permeation",
      "flux",
      "was",
      "below",
      "1000g/m2h.",
      "As",
      "the",
      "silicalite-1",
      "loading",
      "reached",
      "as",
      "high",
      "as",
      "67wt%",
      ",",
      "the",
      "silicalite-1",
      "filled",
      "PDMS",
      "hybrid",
      "membranes",
      "showed",
      "the",
      "highest",
      "separation",
      "factor",
      "of",
      "59",
      ",",
      "while",
      "the",
      "permeation",
      "flux",
      "decreased",
      "compared",
      "with",
      "pure",
      "PDMS",
      "membranes.",
      "Compared",
      "with",
      "other",
      "PDMS",
      "composite",
      "membranes,",
      "OPS/PDMS",
      "MMMs",
      "showed",
      "enhanced",
      "permeation",
      "flux",
      "and",
      "separation",
      "factor",
      "with",
      "much",
      "lower",
      "OPS",
      "loading",
      "(below",
      "10wt%).",
      "The",
      "results",
      "certificated",
      "that",
      "OPS",
      "was",
      "an",
      "efficient",
      "macro-cosslinker",
      "of",
      "PDMS,",
      "which",
      "may",
      "be",
      "useful",
      "for",
      "other",
      "PDMS",
      "composite",
      "membrane",
      "preparation.",
      "4.",
      "Conclusion",
      "In",
      "this",
      "study,",
      "OPS",
      "cross-linked",
      "PDMS",
      "MMMs",
      "were",
      "prepared",
      "and",
      "applied",
      "for",
      "ethanol",
      "recovery",
      "from",
      "aqueous",
      "solution",
      "by",
      "pervaporation.",
      "The",
      "following",
      "conclusions",
      "could",
      "be",
      "obtained:",
      "(1)",
      "Homogeneous",
      "particle",
      "distribution",
      "of",
      "OPS",
      "particles",
      "and",
      "good",
      "integration",
      "with",
      "PDMS",
      "at",
      "the",
      "molecular",
      "level",
      "could",
      "be",
      "ensured",
      "by",
      "the",
      "firm",
      "covalent",
      "bond",
      "between",
      "PDMS",
      "and",
      "OPS",
      "particles."
