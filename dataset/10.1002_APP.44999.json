      "outer",
      "surface",
      "facilitated",
      "CO2",
      "solubility",
      "in",
      "the",
      "membrane.",
      "On",
      "the",
      "other",
      "hand,",
      "more",
      "CO2",
      "possessed",
      "the",
      "adsorption",
      "sites",
      "by",
      "selective",
      "adsorption",
      "leading",
      "to",
      "crowd",
      "out",
      "N2",
      "and",
      "CH4",
      "molecules,",
      "which",
      "was",
      "conducive",
      "to",
      "the",
      "selectivity",
      "enhancement.",
      "However,",
      "further",
      "increase",
      "of",
      "P-MIL-53",
      "loading",
      "in",
      "coating",
      "layer",
      "would",
      "degrade",
      "the",
      "membrane",
      "separation",
      "performance,",
      "especially",
      "for",
      "CO2/CH4",
      "selectivity.",
      "At",
      "the",
      "content",
      "of",
      "20",
      "wt",
      "%,",
      "CH4",
      "permeance",
      "showed",
      "an",
      "upward",
      "turn",
      "obviously",
      "which",
      "was",
      "ascribed",
      "to",
      "CH4",
      "adsorption",
      "increase",
      "by",
      "excessive",
      "porous",
      "MOFs",
      "and",
      "caulking",
      "obstruction",
      "by",
      "particle",
      "agglomeration",
      "as",
      "mentioned",
      "above.",
      "The",
      "value",
      "of",
      "N2",
      "permeance",
      "increased",
      "not",
      "as",
      "significantly",
      "as",
      "CH4",
      "permeance",
      "due",
      "to",
      "the",
      "weaker",
      "affinity",
      "with",
      "P-MIL-53",
      "compared",
      "to",
      "CH4,",
      "resulting",
      "in",
      "slighter",
      "decrease",
      "of",
      "ideal",
      "CO2/N2",
      "selectivity."
