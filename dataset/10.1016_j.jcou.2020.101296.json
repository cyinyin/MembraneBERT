  {
    "tokens": [
      "Extensive",
      "efforts",
      "have",
      "been",
      "made",
      "to",
      "enhance",
      "polymer–filler",
      "compatibility",
      "by",
      "modifying",
      "the",
      "fillers.",
      "The",
      "methods",
      "such",
      "as",
      "introducing",
      "polar",
      "group",
      "to",
      "the",
      "fillers,",
      "coating",
      "polymers",
      "on",
      "the",
      "surface",
      "of",
      "fillers",
      "and",
      "grafting",
      "polymers",
      "to",
      "fillers",
      "were",
      "proposed.",
      "Introducing",
      "–NH2",
      "and",
      "–COOH",
      "groups",
      "was",
      "approved",
      "to",
      "enhance",
      "polymer–filler",
      "compatibility",
      "due",
      "to",
      "the",
      "strong",
      "interaction",
      "between",
      "the",
      "–NH2",
      "or",
      "–COOH",
      "with",
      "polymers.",
      "Putu",
      "et",
      "al.",
      "investigated",
      "the",
      "effect",
      "of",
      "surface",
      "functionalization",
      "of",
      "UiO-66",
      "with",
      "–COOH",
      "and",
      "–NH2",
      "on",
      "the",
      "membrane",
      "performance",
      "[173].",
      "MMMs",
      "with",
      "the",
      "–NH2",
      "modified",
      "fillers",
      "showed",
      "better",
      "CO2",
      "per­",
      "meance",
      "and",
      "selectivity",
      "for",
      "both",
      "CO2/N2",
      "and",
      "CO2/CH4,",
      "resulting",
      "from",
      "the",
      "higher",
      "CO2",
      "solubility",
      "on",
      "the",
      "surface",
      "of",
      "thin",
      "selective",
      "layer.",
      "Filler",
      "coating",
      "by",
      "polydopamine",
      "(PD)",
      "is",
      "another",
      "effective",
      "approach",
      "to",
      "achieve",
      "good",
      "interfacial",
      "compatibility",
      "with",
      "polymer",
      "matrix.",
      "PD",
      "is",
      "an",
      "efficient",
      "adhesion",
      "agent,",
      "which",
      "can",
      "deposit",
      "and",
      "further",
      "adhere",
      "on",
      "almost",
      "all",
      "materials",
      "[61,174].",
      "The",
      "ZIF-8@PD-PI",
      "membrane",
      "was",
      "successfully",
      "fabricated",
      "by",
      "coating",
      "an",
      "ultrathin",
      "PD",
      "layer",
      "on",
      "the",
      "surface",
      "of",
      "the",
      "ZIF-8",
      "nanoparticles",
      "and",
      "then",
      "incorporating",
      "the",
      "fillers",
      "into",
      "the",
      "polymer",
      "named",
      "TBDA2–6FDA-PI",
      "[175].",
      "Due",
      "to",
      "the",
      "hydrogen",
      "bond",
      "interaction",
      "between",
      "ample",
      "amine",
      "groups",
      "on",
      "PD",
      "molecules",
      "and",
      "the",
      "amine",
      "in",
      "TB-based",
      "PI",
      "polymers,",
      "the",
      "as",
      "prepared",
      "membranes",
      "presented",
      "good",
      "compatibility.",
      "For",
      "equimolar",
      "CO2/N2",
      "mixed",
      "gas,",
      "the",
      "ZIF-8@PD-PI(20%)",
      "membrane",
      "showed",
      "a",
      "CO2/N2",
      "selectivity",
      "of",
      "21",
      "at",
      "0.1",
      "MPa",
      ".",
      "The",
