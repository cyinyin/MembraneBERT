      "molecules",
      "through",
      "the",
      "selective",
      "layer",
      "[53,54].",
      "The",
      "rate",
      "of",
      "physical",
      "aging",
      "was",
      "controlled",
      "by",
      "the",
      "use",
      "of",
      "additives",
      "(amine",
      "function­",
      "alized",
      "MIL-101)",
      "that",
      "give",
      "rise",
      "to",
      "intimate",
      "interaction",
      "with",
      "the",
      "membrane",
      "matrix.",
      "Moreover,",
      "this",
      "transport",
      "behavior",
      "shows",
      "no",
      "significant",
      "compaction",
      "and",
      "plasticization",
      "occurred",
      "in",
      "the",
      "membrane",
      "structure.",
      "The",
      "stable",
      "performance",
      "of",
      "the",
      "TFN",
      "membrane",
      "demonstrates",
      "its",
      "potential",
      "for",
      "industrial",
      "applications",
      "in",
      "CO2/CH4",
      "separation.",
      "3.3.4.",
      "Gas",
      "separation",
      "performance",
      "of",
      "Pebax",
      "based",
      "membranes",
      "membranes",
      "prepared",
      "based",
      "on",
      "Pebax®",
      "1657",
      "in",
      "the",
      "literature.",
      "By",
      "comparing",
      "the",
      "performance",
      "of",
      "all",
      "membranes",
      "provided",
      "in",
      "this",
      "table,",
      "it",
      "can",
      "be",
      "concluded",
      "that",
      "the",
      "TEPA-MIL-101-modified",
      "Pebax",
      "membranes",
      "developed",
      "showed",
      "reasonable",
      "performance",
      "in",
      "terms",
      "of",
      "permeability",
      "and",
      "selectivity.",
      "The",
      "trade-off",
      "between",
      "the",
      "permeability",
      "and",
      "selectivity",
      "of",
      "synthesized",
      "membranes",
      "was",
      "also",
      "evaluated",
      "by",
      "considering",
      "Robeson’s",
      "upper",
      "bound.",
      "The",
      "results",
      "pointed",
      "out",
      "that",
      "the",
      "TEPA-MOF",
      "based",
      "mem­",
      "branes",
      "showed",
      "a",
      "performance",
      "close",
      "to",
      "the",
      "Robeson",
      "upper",
      "bound",
      "as",
      "compared",
      "to",
      "the",
      "neat",
      "and",
      "MIL-101-modified",
      "membrane",
      "(",
      "implies",
      "the",
      "impact",
      "of",
      "amine",
      "groups",
      "on",
      "the",
      "improvement",
      "of",
      "membrane",
      "performance.",
      "4.",
      "Conclusion",
      "In",
      "summary,",
      "a",
      "post-synthesis",
      "procedure",
      "was",
      "successfully",
      "conducted",
      "by",
      "tetraethylenepentamine",
      "(TEPA)",
      "on",
      "MIL-101",
      "to",
      "develop",
      "an",
      "aminefunctionalized",
      "MOF.",
      "The",
      "MIL-101",
      "and",
      "TEPA-MIL-101",
      "were",
      "individu­",
      "ally",
      "incorporated",
      "into",
      "Pebax®",
      "1657",
      "polymer",
      "to",
      "fabricate",
      "thin-film",
      "nanocomposite",
      "(TFN)",
      "membranes.",
      "Single",
      "and",
      "mixed",
      "gas",
      "permeation",
      "test",
      "of",
      "membranes",
      "was",
      "carried",
      "out",
      "to",
      "evaluate",
      "the",
      "effect",
      "of",
      "amine",
      "groups",
      "on",
      "the",
      "gas",
      "permeability",
      "and",
      "selectivity.",
      "Affinity",
      "induced",
      "by",
      "amine",
      "groups",
      "enhanced",
      "CO2",
      "permeability",
      "and",
      "CO2/CH4",
      "selectivity",
      "via",
      "increasing",
      "thermodynamic",
      "interactions",
      "between",
      "membrane",
      "matrix",
      "and",
      "permeating",
      "molecules.",
      "The",
      "highest",
      "performance",
      "was",
      "achieved",
      "for",
      "Pebax",
      "membrane",
      "incorporated",
      "with",
      "5",
      "wt%",
      "of",
      "TEPA-MIL-101",
      ".",
      "This",
      "TFN",
      "membrane",
      "exhibited",
      "the",
      "CO2",
      "permeability",
      "of",
      "34.6",
      "Barrer",
      "and",
      "outstanding",
      "CO2/CH4",
      "selectivity",
      "of",
      "46.33",
      ",",
      "which",
      "was",
      "about",
      "63%",
      "and",
      "110%",
      "higher",
      "than",
      "the",
      "neat",
      "membrane,",
      "respectively.",
      "In",
      "addition,",
      "the",
      "results",
      "revealed",
      "that",
      "the",
      "performance",
      "of",
      "the",
      "neat",
      "membrane",
      "was",
      "not",
      "sensitive",
      "to",
      "feed",
      "pressure",
      "changes;",
      "however,",
      "increasing",
      "FFV",
      "of",
      "membranes",
      "induced",
      "by",
      "incorporation",
      "of",
      "TEPA-MIL-101",
      "made",
      "the",
      "transport",
      "behavior",
      "more",
      "sensitive",
      "against",
      "feed",
      "pressure",
      "which",
      "resulted",
      "in",
      "reduction",
      "of",
      "membrane",
      "selectivity.",
      "This",
      "work",
      "indicated",
      "that",
      "the",
      "amine-functionalized",
      "MIL-101",
      "with",
      "a",
      "high",
      "affinity",
      "toward",
      "CO2",
      "molecules",
      "is",
      "suitable",
      "filler",
      "for",
      "membrane",
      "modification",
      "to",
      "separate",
      "CO2",
      "from",
      "biogas/gas",
      "stream."
