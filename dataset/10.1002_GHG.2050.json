      "C=O",
      "in",
      "CA)",
      "CA/γ",
      "-CD-MOF",
      "MMM,",
      "enables",
      "the",
      "effective",
      "interaction",
      "of",
      "CO2",
      "as",
      "compared",
      "to",
      "nonpolar",
      "methane.",
      "Therefore,",
      "a",
      "rise",
      "in",
      "the",
      "permeability",
      "of",
      "CO2",
      "is",
      "observed",
      "in",
      "MMM",
      "because",
      "of",
      "sorption",
      "of",
      "CO2",
      "into",
      "the",
      "membrane.",
      "In",
      "contrast,",
      "a",
      "drop",
      "in",
      "CH4",
      "permeability",
      "is",
      "noticed",
      "because",
      "of",
      "its",
      "nonpolar",
      "nature,",
      "large",
      "kinematic",
      "diameter,",
      "and",
      "low",
      "diffusivity",
      "in",
      "CA/γ",
      "-CD-MOF",
      "MMM.",
