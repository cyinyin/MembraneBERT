      "increase",
      "in",
      "filler",
      "loading,",
      "the",
      "solubility",
      "of",
      "CO2",
      "gas",
      "increases",
      "significantly",
      "as",
      "compared",
      "to",
      "that",
      "for",
      "CH4."
