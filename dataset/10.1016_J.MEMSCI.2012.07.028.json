      "reserved.",
      "1.",
      "Introduction",
      "Puriﬁcation",
      "and",
      "recovery",
      "of",
      "hydrogen",
      "from",
      "hydrocarbons",
      "in",
      "reﬁnery",
      "streams",
      "(such",
      "as",
      "H2/CH4",
      "and",
      "H2/C3H8)",
      "in",
      "the",
      "petrochemical",
      "industry",
      "is",
      "an",
      "emerging",
      "area",
      "of",
      "research",
      "in",
      "the",
      "study",
      "of",
      "gas",
      "separation",
      "by",
      "membranes",
      "and",
      "is",
      "becoming",
      "a",
      "key",
      "approach",
      "to",
      "meeting",
      "increasing",
      "demands",
      "for",
      "hydrogen",
      "[1,2].",
      "Membrane-based",
      "hydrogen",
      "separation",
      "is",
      "currently",
      "considered",
      "among",
      "the",
      "most",
      "promising",
      "methods",
      "because",
      "of",
      "its",
      "low",
      "energy",
      "consumption",
      "and",
      "ultimate",
      "cost",
      "effectiveness",
      "[3],",
      "compared",
      "with",
      "conventional",
      "methods",
      "such",
      "as",
      "pressure",
      "swing",
      "adsorption",
      "and",
      "fractional/cryogenic",
      "distillation.",
      "Many",
      "polymeric",
      "membranes",
      "have",
      "been",
      "developed",
      "for",
      "this",
      "type",
      "of",
      "separation,",
      "although",
      "most",
      "of",
      "them",
      "have",
      "suffered",
      "from",
      "either",
      "low",
      "permeability",
      "or",
      "low",
      "selectivity,",
      "and",
      "from",
      "many",
      "other",
      "issues,",
      "such",
      "as",
      "fouling,",
      "plasticization,",
      "and",
      "condensation",
      "of",
      "hydrocarbon",
      "vapors",
      "on",
      "membrane",
      "surfaces",
      "[2].",
      "Therefore,",
      "H2-permselective",
      "inorganic",
      "membranes",
      "(Pd-based",
      "metallic",
      "membranes,",
      "silica",
      "membranes,",
      "zeolite",
      "membranes,",
      "carbon",
      "molecular",
      "sieve",
      "membranes,",
      "and",
      "mixed",
      "tetrahedral–octahedral",
      "oxide",
      "membranes)",
      "have",
      "attracted",
      "extensive",
      "interest",
      "for",
      "their",
      "ability",
      "to",
      "recover",
      "H2",
      "from",
      "hydrocarbons",
      "[4–8]."
