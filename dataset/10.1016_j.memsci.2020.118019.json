  {
    "tokens": [
      "Incorporating",
      "microporous",
      "inorganic",
      "nanofillers",
      "with",
      "size-sieving",
      "ability",
      "into",
      "the",
      "polymer",
      "matrix",
      ",",
      "called",
      "mixed",
      "matrix",
      "membranes",
      "(",
      "MMMs",
      ")",
      ",",
      "is",
      "another",
      "approach",
      "to",
      "suppress",
      "the",
      "plasticization",
      "and",
      "also",
      "boost",
      "gas-pairs",
      "selectivity",
      "15-17]",
      ".",
      "Recent",
      "studies",
      "have",
      "demonstrated",
      "the",
      "enormous",
      "potential",
      "of",
      "metal-organic",
      "frameworks",
      "(",
      "MOFs",
      ")",
      "with",
      "promising",
      "sieving",
      "ability",
      "for",
      "C3H6/C3H6",
      "and",
      "C2H4/C2H6",
      "separation",
      ".",
      "Zeolitic-imidazolate",
      "frameworks",
      "(",
      "ZIFs",
      ")",
      ",",
      "a",
      "subclass",
      "of",
      "MOFs",
      ",",
      "are",
      "composed",
      "of",
      "transitional",
      "metals",
      "(",
      "such",
      "as",
      "Zn",
      "and",
      "Co",
      ")",
      "bridged",
      "via",
      "organic",
      "imidazole-based",
      "linkers",
      "which",
      "offer",
      "not",
      "only",
      "high",
      "chemical",
      "and",
      "thermal",
      "stability",
      "also",
      "excellent",
      "compatibility",
      "with",
      "polymer",
      "matrix",
      ".",
      "An",
      "et",
      "al",
      ".",
      "reported",
      "that",
      "incorporating",
      "ZIF-67",
      "into",
      "the",
      "6FDA-DAM",
      "matrix",
      "considerably",
      "improved",
      "both",
      "C3H6",
      "permeability",
      "and",
      "C3H6/C3H8",
      "permselectivity",
      ".",
      "Mixed",
      "gas",
      "C3H6",
      "permeability",
      "of",
      "28",
      "Barrer",
      "and",
      "C3H6/C3H8",
      "permselectivity",
      "of",
      "17",
      "were",
      "achieved",
      ",",
      "at",
      "2",
      "bar",
      "and",
      "35",
      "ºC",
      ",",
      "for",
      "the",
      "membrane",
      "consisting",
      "of",
      "21",
      "wt%",
      "ZIF-67",
      "nanofillers",
      ".",
      "However",
      ",",
      "the",
      "C3H6/C3H8",
      "separation",
      "performance",
      "of",
      "the",
      "MMM",
      "at",
      "high",
      "C3H6",
      "partial",
      "pressures",
      "was",
      "not",
      "reported",
      ".",
      "Liu",
      "et",
      "al",
      ".",
      "designed",
      "a",
      "novel",
      "type",
      "of",
      "metal-organic",
      "frameworks",
      "(",
      "MOFs",
      ")",
      "with",
      "face-centered",
      "cubic",
      "topology",
      "(",
      "named",
      "Zr",
      "-",
      "fum-fcu-MOF",
      ")",
      "and",
      "preferentially",
      "adjusted",
      "the",
      "contraction",
      "of",
      "pore-aperture",
      "size",
      "to",
      "improve",
      "C3H6/C3H8",
      "permselectivity",
      "of",
      "6FDA-DAM-based",
      "membranes",
      ".",
      "Interestingly",
      ",",
      "the",
      "membrane",
      "containing",
      "29.4",
      "wt%",
      "of",
      "Zr-fum-fcu-MOF",
      "exhibited",
      "mixed",
      "gas",
      "C3H6",
      "permeability",
      "of",
      "20",
      "Barrer",
      "and",
      "C3H6/C3H8",
      "permselectivity",
      "of",
      "about",
      "11",
      "at",
      "5",
      "bar",
      "and",
      "35",
      "ºC",
      "."
    ],
