      "with",
      "the",
      "pure",
      "polymer",
      "membranes",
      ",",
      "these",
      "novel",
      "MMMs",
      "effectively",
      "improved",
      "the",
      "permeability",
      "and",
      "selectivity",
      "of",
      "CO2",
      ".",
