  {
    "tokens": [
      "Jiang",
      "and",
      "co-workers",
      "immobilized",
      "PEI",
      "polymers",
      "within",
      "the",
      "pore",
      "channels",
      "of",
      "MIL-101(Cr)",
      "and",
      "incorporated",
      "the",
      "obtained",
      "composite",
      "into",
      "sulfonated",
      "poly(ether",
      "ether",
      "ketone)",
      "(SPEEK)",
      "to",
      "prepare",
      "MMMs.",
      "They",
      "found",
      "that",
      "the",
      "CO2",
      "separation",
      "performance",
      "of",
      "the",
      "PEI@MIL-101(Cr)/SPEEK",
      "MMMs",
      "was",
      "greatly",
      "improved",
      "compared",
      "to",
      "the",
      "pristine",
      "SPEEK",
      "membrane",
      "and",
      "the",
      "MIL-101(Cr)/SPEEK",
      "MMMs,",
      "due",
      "to",
      "the",
      "abundant",
      "amine",
      "carriers",
      "provided",
      "by",
      "the",
      "PEI",
      "polymers",
      "(Xin",
      "et",
      "al.,",
      "2015b).",
      "Therefore,",
      "the",
      "PEI",
      "chains",
      "containing",
      "a",
      "large",
      "amount",
      "of",
      "amine",
      "groups",
      "extended",
      "into",
      "the",
      "XLPEO",
      "matrix",
      "may",
      "help",
      "to",
      "transfer",
      "CO2",
      "molecules",
      "along",
      "the",
      "PEI",
      "chains",
      "to",
      "the",
      "channels",
      "of",
      "CAU-1.",
      "To",
      "conﬁrm",
      "this",
      "inference,",
      "CO2",
      "and",
      "CH4",
      "adsorption",
      "properties",
      "of",
      "the",
      "pristine",
      "XLPEO",
      "membrane",
      "and",
      "MMMs",
      "with",
      "20",
      "wt%",
      "loading",
      "of",
      "CAU-1",
      "and",
      "PEI-CAU-1",
      "at",
      "pressures",
      "up",
      "to",
      "12",
      "bar",
      "were",
      "measured.",
      "As",
      "shown",
      "in",
      "Fig.",
      "S6",
      "and",
      "Table",
      "S3",
      "(Supplementary",
      "Material),",
      "both",
      "the",
      "incorporation",
      "of",
      "CAU-1",
      "and",
      "PEI-CAU-1",
      "can",
      "increase",
      "the",
      "gas",
      "solubility",
      "of",
      "XLPEO",
      "membrane.",
      "In",
      "addition,",
      "the",
      "solubility",
      "coefﬁcients",
      "XLPEO",
      "membrane",
      "is",
      "higher",
      "than",
      "that",
      "of",
      "CAU-1/XLPEO",
      "membrane,",
      "which",
      "may",
      "be",
      "attributed",
      "to",
      "the",
      "attached",
      "PEI",
      "molecules",
      "spread",
      "in",
      "the",
      "XLPEO",
      "matrix.",
      "As",
      "to",
      "the",
      "diffusivity",
      "coefﬁcients",
      "and",
      "diffuse",
      "selectivity,",
      "the",
      "PEI-CAU-1/XLPEO",
      "membrane",
      "is",
      "higher",
      "than",
      "the",
      "pristine",
      "XLPEO",
      "membrane,",
      "corresponding",
      "to",
      "the",
      "facilitating",
      "effect",
      "of",
      "amine",
      "groups",
      "to",
      "the",
      "transport",
      "of",
      "CO2",
      "molecules.",
      "For",
      "CAU-1/",
      "XLPEO",
      "membrane,",
      "however,",
      "the",
      "diffusivity",
      "coefﬁcients",
      "increased",
      "dramatically",
      "and",
      "the",
      "diffuse",
      "selectivity",
      "decreased",
      "obviously,",
      "which",
      "supports",
      "the",
      "speculation",
      "that",
      "the",
      "agglomeration",
      "of",
      "CAU-1",
      "has",
      "caused",
      "structural",
      "defects",
      "in",
      "the",
      "membrane.",
      "Combining",
      "the",
      "above",
      "ﬁndings",
      "with",
      "the",
      "permeation",
      "results",
      "in",
      "this",
      "work,",
      "it",
      "is",
      "concluded",
      "that",
      "the",
      "improved",
      "CO2",
      "permeability",
      "and",
      "CO2/CH4",
      "separation",
      "factor",
      "of",
      "the",
      "PEI-CAU-1/XLPEO",
      "MMMs",
      "originate",
      "from",
      "the",
      "synergistic",
      "effects",
      "of",
      "the",
      "fully",
      "exploited",
      "intrinsic",
      "separation",
      "ability",
      "of",
      "CAU-1",
      "material",
      "beneﬁting",
      "from",
      "the",
      "enhanced",
      "particle",
      "dispersion",
      "in",
      "MMMs,",
      "and",
      "the",
      "amine",
      "carriers",
      "introduced",
      "by",
      "the",
      "attached",
      "PEI",
      "polymers.",
      "Especially,",
      "the",
      "30",
      "wt%",
      "PEI-CAU-1/XLPEO",
      "membrane",
      "shows",
      "a",
      "CO2",
      "permeability",
      "of",
      "546",
      "Barrer",
      "and",
      "a",
      "CO2/CH4",
      "separation",
      "factor",
      "of",
      "27.8",
      ",",
      "increasing",
      "by",
      "165%",
      "and",
      "50%",
      "respectively",
      "compared",
      "with",
      "the",
      "pristine",
      "XLPEO",
      "membrane.",
      "The",
      "obtained",
      "results",
      "may",
      "provide",
      "useful",
      "information",
      "in",
      "facilitating",
      "the",
      "applications",
      "of",
      "promising",
      "MOF-containing",
      "MMMs",
      "for",
      "the",
      "practical",
      "membrane-based",
      "natural",
      "gas",
      "puriﬁcation."
