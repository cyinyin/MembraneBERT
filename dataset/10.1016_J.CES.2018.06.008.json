[
  {
    "tokens": [
      "Preparation",
      "of",
      "defect-less",
      "MMMs",
      "was",
      "facilitated",
      "with",
      "surface",
      "modiﬁcation.",
      "Improved",
      "particle",
      "dispersity",
      "helped",
      "CAU-1",
      "to",
      "exploit",
      "its",
      "separation",
      "potential.",
      "Permeability",
      "and",
      "selectivity",
      "of",
      "the",
      "membranes",
      "were",
      "increased",
      "simultaneously.",
      "a",
      "r",
      "t",
      "i",
      "c",
      "l",
      "e",
      "i",
      "n",
      "f",
      "o",
      "Accepted",
      "1",
      "June",
      "2018",
      "Available",
      "online",
      "2",
      "June",
      "2018",
      "External",
      "surface",
      "functionalization",
      "CO2",
      "separation",
      "a",
      "b",
      "s",
      "t",
      "r",
      "a",
      "c",
      "t",
      "Poor",
      "dispersity",
      "of",
      "ﬁller",
      "particles",
      "always",
      "limits",
      "their",
      "application",
      "in",
      "mixed",
      "matrix",
      "membranes",
      "(MMMs),",
      "increasing",
      "the",
      "difﬁculties",
      "in",
      "membrane",
      "fabrication",
      "and",
      "restraining",
      "the",
      "full",
      "exploitation",
      "of",
      "the",
      "intrinsic",
      "separation",
      "ability",
      "of",
      "the",
      "ﬁllers.",
      "Herein,",
      "polyethyleneimine",
      "(PEI),",
      "a",
      "functional",
      "branched",
      "polymer,",
      "was",
      "covalently",
      "bonded",
      "on",
      "the",
      "outer",
      "surface",
      "of",
      "CAU-1",
      "nanoparticles",
      "to",
      "implement",
      "increased",
      "colloidal",
      "stability",
      "and",
      "improved",
      "CO2",
      "afﬁnity",
      "for",
      "MMMs",
      "preparation.",
      "As",
      "a",
      "result,",
      "the",
      "dispersity",
      "of",
      "CAU-1",
      "particles",
      "in",
      "solvent",
      "and",
      "MMMs",
      "was",
      "greatly",
      "improved",
      "after",
      "surface",
      "functionalization.",
      "Meanwhile,",
      "the",
      "grafted",
      "PEI",
      "polymer",
      "chains",
      "can",
      "serve",
      "as",
      "CO2",
      "carriers",
      "simultaneously,",
      "which",
      "beneﬁts",
      "the",
      "CO2",
      "transport",
      "in",
      "MMMs.",
      "The",
      "prepared",
      "MMMs",
      "based",
      "on",
      "modiﬁed",
      "CAU-1",
      "exhibit",
      "largely",
      "improved",
      "CO2/CH4",
      "separation",
      "performance,",
      "with",
      "a",
      "CO2",
      "permeability",
      "of",
      "546",
      "Barrer",
      "and",
      "a",
      "CO2/CH4",
      "separation",
      "factor",
      "of",
      "27.8",
      "at",
      "30wt%",
      "ﬁller",
      "loading,",
      "showing",
      "165%",
      "and",
      "50%",
      "increases",
      "respectively",
      "compared",
      "with",
      "the",
      "pristine",
      "polymer",
      "membrane.",
      "The",
      "modiﬁcation",
      "approach",
      "presented",
      "here",
      "is",
      "expected",
      "to",
      "extend",
      "the",
      "functionality",
      "of",
      "MOFs",
      "and",
      "facilitate",
      "the",
      "development",
      "of",
      "MMMs.",
      "2018",
      "Elsevier",
      "Ltd.",
      "All",
      "rights",
      "reserved.",
      "1.",
      "Introduction",
      "Gas",
      "separation",
      "continues",
      "to",
      "be",
      "an",
      "active",
      "research",
      "area",
      "in",
      "material",
      "and",
      "chemistry",
      "science",
      "as",
      "well",
      "as",
      "chemical",
      "engineering",
      "(Sholl",
      "and",
      "Lively,",
      "2016).",
      "Membrane",
      "separation",
      "is",
      "considered",
      "a",
      "costeffective",
      "and",
      "environmentally",
      "friendly",
      "technology",
      "compared",
      "to",
      "other",
      "technologies",
      "such",
      "as",
      "cryogenic",
      "distillation,",
      "liquid-phase",
      "absorption,",
      "and",
      "pressure",
      "swing",
      "adsorption,",
      "especially",
      "for",
      "largescale",
      "gas",
      "separation",
      "(Baker",
      "and",
      "Low,",
      "2014;",
      "Bernardo",
      "et",
      "al.,",
      "2009;",
      "Galizia",
      "et",
      "al.,",
      "2017;",
      "Koros",
      "and",
      "Fleming,",
      "1993;",
      "Wang",
      "et",
      "al.,",
      "2016b).",
      "However,",
      "current",
      "commercial",
      "membrane",
      "systems",
      "still",
      "face",
      "great",
      "challenges",
      "including",
      "low",
      "gas",
      "permeability",
      "of",
      "typical",
      "polymeric",
      "membranes",
      "and",
      "high",
      "preparation",
      "cost",
      "of",
      "inorganic",
      "porous",
      "membranes",
      "(Ghalei",
      "et",
      "al.,",
      "2017;",
      "Kang",
      "et",
      "al.,",
      "2017;",
      "Koros",
      "and",
      "Mahajan,",
      "2000;",
      "Li",
      "et",
      "al.,",
      "2015a).",
      "Thus,",
      "it",
      "is",
      "imperative",
      "to",
      "develop",
      "inexpensive",
      "membranes",
      "possessing",
      "a",
      "largely",
      "enhanced",
      "permeability",
      "as",
      "well",
      "as",
      "considerable",
      "selectivity",
      "to",
      "cost-effectively",
      "process",
      "large",
      "amounts",
      "of",
      "industrial",
      "gas",
      "mixtures."
