[
  {
    "tokens": [
      "In",
      "this",
      "work",
      "a",
      "series",
      "of",
      "mixed",
      "matrix",
      "membranes",
      "(",
      "MMMs",
      ")",
      "containing",
      "metal",
      "organic",
      "frameworks",
      "(",
      "MOFs",
      ")",
      "were",
      "fabricated",
      "to",
      "investigate",
      "the",
      "inﬂuence",
      "of",
      "post-treatment",
      "on",
      "their",
      "gas",
      "separation",
      "properties",
      ".",
      "It",
      "was",
      "revealed",
      "that",
      "gas",
      "permeabilities",
      "increased",
      "considerably",
      "as",
      "treatment",
      "temperature",
      "increased",
      "from",
      "150",
      "℃",
      "to",
      "180",
      "℃",
      "and",
      "remained",
      "almost",
      "unchanged",
      "after",
      "200",
      "℃",
      ";",
      "gas",
      "permeability",
      "of",
      "MMMs",
      "from",
      "200",
      "℃",
      "treatment",
      "was",
      "about",
      "3",
      "times",
      "higher",
      "when",
      "compared",
      "with",
      "MMMs",
      "treated",
      "at",
      "150",
      "℃",
      ".",
      "From",
      "results",
      "of",
      "physical",
      "characterization",
      "including",
      "TGA",
      ",",
      "XRD",
      ",",
      "SEM",
      ",",
      "ATR-FTIR",
      "and",
      "nitrogen",
      "absorption",
      "it",
      "was",
      "inferred",
      "that",
      "higher",
      "temperature",
      "treatment",
      "induced",
      "gas",
      "permeability",
      "increase",
      "should",
      "be",
      "mainly",
      "attributed",
      "to",
      "more",
      "effective",
      "removal",
      "of",
      "residual",
      "solvent",
      "in",
      "micro-pores",
      "of",
      "MOFs",
      ";",
      "and",
      "gas",
      "permeation",
      "properties",
      "of",
      "MMMs",
      "with",
      "different",
      "treatment",
      "durations",
      "from",
      "24",
      "h",
      "to",
      "96",
      "h",
      "further",
      "conﬁrmed",
      "our",
      "conclusion",
      ".",
      "This",
      "heat",
      "treatment",
      "induced",
      "permeability",
      "increase",
      "phenomenon",
      "was",
      "further",
      "veriﬁed",
      "by",
      "varying",
      "the",
      "polymer",
      "and",
      "MOF",
      "combinations",
      ".",
      "At",
      "the",
      "end",
      "Cu3",
      "(",
      "BTC",
      ")",
      "2/ODPA",
      "–",
      "TMPDA",
      "MMMs",
      "with",
      "different",
      "MOF",
      "loadings",
      "were",
      "prepared",
      "and",
      "the",
      "one",
      "with",
      "best",
      "performance",
      "appeared",
      "at",
      "40",
      "wt%",
      "loading",
      ":",
      "a",
      "dramatic",
      "increase",
      "of",
      "CO2",
      "permeability",
      "from",
      "47.7",
      "Barrer",
      "to",
      "260.7",
      "Barrer",
      "with",
      "almost",
      "unchanged",
      "CO2/CH4",
      "selectivity",
      "from",
      "29.26",
      "to",
      "27.75",
      ".",
      "&",
      "2014",
      "Published",
      "by",
      "Elsevier",
      "B",
      ".",
      "V",
      ".",
      "1",
      ".",
      "Introduction",
      "Membrane-based",
      "gas",
      "separation",
      "is",
      "a",
      "rapidly",
      "developing",
      "technology",
      ".",
      "It",
      "has",
      "been",
      "widely",
      "applied",
      "in",
      "natural",
      "gas",
      "puriﬁcation",
      ",",
      "hydrogen",
      "recovery",
      "and",
      "air",
      "separation",
      ",",
      "and",
      "also",
      "showed",
      "promising",
      "potential",
      "in",
      "carbon",
      "capture",
      ".",
      "Polymers",
      "were",
      "ﬁrst",
      "studied",
      "as",
      "membrane",
      "material",
      "since",
      "they",
      "are",
      "easier",
      "to",
      "be",
      "fabricated",
      "into",
      "ﬁlms",
      ".",
      "However",
      ",",
      "the",
      "trade-off",
      "relationship",
      "between",
      "gas",
      "permeability",
      "and",
      "selectivity",
      "has",
      "restricted",
      "their",
      "overall",
      "gas",
      "separation",
      "properties",
      "as",
      "illustrated",
      "by",
      "Robeson",
      "upper",
      "bound",
      "which",
      "was",
      "concluded",
      "in",
      "1991",
      "and",
      "updated",
      "in",
      "2008",
      ".",
      "Recently",
      ",",
      "some",
      "new",
      "kinds",
      "of",
      "polymeric",
      "membranes",
      "with",
      "excellent",
      "gas",
      "separation",
      "properties",
      "have",
      "been",
      "prepared",
      ",",
      "such",
      "as",
      "membranes",
      "from",
      "polymers",
      "of",
      "intrinsic",
      "microporosity",
      "(",
      "PIM",
      ")",
      "and",
      "thermally",
      "rearranged",
      "(",
      "TR",
      ")",
      "polymer",
      ",",
      "and",
      "their",
      "gas",
      "separation",
      "properties",
      "have",
      "even",
      "exceeded",
      "2008",
      "Robeson",
      "upper",
      "bound",
      ".",
      "Unfortunately",
      ",",
      "the",
      "presence",
      "of",
      "a",
      "fatal",
      "drawback",
      ",",
      "namely",
      "poor",
      "solubility",
      "in",
      "common",
      "solvents",
