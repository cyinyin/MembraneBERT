  {
    "tokens": [
      "Conclusions",
      "In",
      "this",
      "work,",
      "the",
      "adsorption",
      "characteristics",
      "of",
      "CO2",
      "and",
      "N2",
      "on",
      "MIL-101",
      "and",
      "AC",
      "were",
      "studied.",
      "The",
      "DSLF",
      "model",
      "was",
      "used",
      "to",
      "model",
      "the",
      "experimental",
      "CO2",
      "adsorption",
      "data.",
      "The",
      "isosteric",
      "heats",
      "of",
      "CO2",
      "adsorption",
      "on",
      "MIL-101",
      "and",
      "AC",
      "were",
      "calculated",
      "from",
      "virial",
      "model.",
      "The",
      "adsorption",
      "kinetics",
      "of",
      "CO2",
      "on",
      "the",
      "MIL-101",
      "and",
      "AC",
      "can",
      "be",
      "well",
      "depicted",
      "by",
      "the",
      "micropore",
      "diffusion",
      "model.",
      "The",
      "Henry",
      "law",
      "constants",
      "were",
      "used",
      "to",
      "estimate",
      "the",
      "CO2/N2",
      "selectivities",
      "on",
      "the",
      "two",
      "adsorbents",
      "at",
      "298",
      "K.",
      "Results",
      "showed",
      "that",
      "the",
      "CO2",
      "uptakes",
      "on",
      "MIL-101",
      "was",
      "somewhat",
      "higher",
      "than",
      "those",
      "on",
      "AC.",
      "The",
      "isosteric",
      "heat",
      "of",
      "CO2",
      "adsorption",
      "on",
      "the",
      "MIL-101",
      "at",
      "zero",
      "loading",
      "was",
      "much",
      "higher",
      "than",
      "that",
      "on",
      "the",
      "AC",
      "due",
      "to",
      "the",
      "stronger",
      "interaction",
      "between",
      "CO2",
      "molecules",
      "and",
      "the",
      "unsaturated",
      "metal",
      "sites",
      "Cr3?",
      "on",
      "MIL-101.",
      "Furthermore,",
      "the",
      "dramatically",
      "decreased",
      "isosteric",
      "heats",
      "of",
      "CO2",
      "adsorption",
      "on",
      "MIL-101",
      "indicated",
      "a",
      "more",
      "heterogeneous",
      "surface",
      "of",
      "MIL101.",
      "However,",
      "the",
      "AC",
      "surface",
      "was",
      "much",
      "more",
      "homogeneous",
      "in",
      "comparison",
      "with",
      "that",
      "of",
      "MIL-101.",
      "The",
      "diffusion",
      "coefﬁcients",
      "of",
      "CO2",
      "in",
      "MIL-101",
      "and",
      "AC",
      "range",
      "from",
      "2.",
      "9",
      "10-10",
      "to",
      "2.",
      "9",
      "10-10",
      "cm2/s",
      "and",
      "1.",
      "9",
      "10-10",
      "to",
      "2.",
      "9",
      "10-10",
      "cm2/s,",
      "respectively.",
      "The",
      "Ea",
      "for",
      "CO2",
      "adsorption",
      "on",
      "the",
      "MIL-101",
      "was",
      "slightly",
      "lower",
      "than",
      "that",
      "on",
      "the",
