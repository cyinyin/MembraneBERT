      "suggesting",
      "that",
      "MIL-101",
      "was",
      "much",
      "more",
      "favorable",
      "for",
      "the",
      "CO2",
      "adsorption.",
      "The",
      "CO2/N2",
      "selectivity",
      "on",
      "MIL-101",
